{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["VITEST_MAX_WORKERS", "FDRIVE_TEST_SFTPGO_WRITE_IMAGE"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "outputs": ["coverage/**"],
      "cache": false
    },
    "test:integration": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
