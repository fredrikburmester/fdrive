# X-Forwarded-Proto is passed through from a private-network edge proxy and
# otherwise set from the connection itself; see ../Caddyfile.
{
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	request_body {
		max_size 0
	}
	header -Server
	@office host {$FDRIVE_COLLABORA_HOST}
	handle @office {
		reverse_proxy collabora:9980
	}
	handle /api/* {
		reverse_proxy api:3001
	}
	handle /mcp* {
		reverse_proxy api:3001
	}
	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}
