# Direct LAN HTTP works by default. Behind an HTTPS edge, set
# FDRIVE_PUBLIC_URL=https://... in deploy/.env: compose.yaml derives
# FDRIVE_FORWARDED_PROTO from it before starting Caddy (see ../Caddyfile).
# The scheme is deployment-controlled; client headers cannot override it.
:80 {
	request_body {
		max_size 0
	}
	header -Server
	@office host {$FDRIVE_COLLABORA_HOST}
	handle @office {
		reverse_proxy collabora:9980 {
			header_up X-Forwarded-Proto {$FDRIVE_FORWARDED_PROTO:http}
		}
	}
	handle /api/* {
		reverse_proxy api:3001 {
			header_up X-Forwarded-Proto {$FDRIVE_FORWARDED_PROTO:http}
		}
	}
	handle /mcp* {
		reverse_proxy api:3001 {
			header_up X-Forwarded-Proto {$FDRIVE_FORWARDED_PROTO:http}
		}
	}
	handle {
		encode zstd gzip
		reverse_proxy web:3000 {
			header_up X-Forwarded-Proto {$FDRIVE_FORWARDED_PROTO:http}
		}
	}
}
