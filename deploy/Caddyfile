:80 {
	# No request body limit: uploads can be large files.
	request_body {
		max_size 0
	}

	header {
		-Server
	}

	# File downloads (and WOPI/MCP payloads) must pass through untouched so
	# Range and Content-Length survive: compression is scoped to the web
	# handle below, never applied here.
	handle /api/* {
		reverse_proxy api:3001
	}

	handle /wopi/* {
		reverse_proxy api:3001
	}

	handle /mcp* {
		reverse_proxy api:3001
	}

	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}
