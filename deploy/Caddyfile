# The scheme every service is told the browser used (X-Forwarded-Proto) is
# whatever the edge in front of this proxy says it was, when there is one:
# an HTTPS reverse proxy on the LAN or on the host forwards "https", a direct
# LAN client gets the scheme of its own connection (http). The api derives
# Secure cookies from it and the bundled ONLYOFFICE builds every URL it
# hands the browser from it, so no deployment setting is needed for HTTPS.
#
# Forwarded headers are honoured from private-network peers only, which is
# where an edge proxy lives (host, LAN, or another container); anything else
# has them replaced. A LAN client forging "https" can only affect its own
# session: it gets a Secure cookie it cannot send back over plain http.
{
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	# No request body limit: uploads can be large files.
	request_body {
		max_size 0
	}

	header {
		-Server
	}

	# Bundled ONLYOFFICE stays on fdrive's own origin, so onboarding can
	# enable it without rebuilding the web app's Content-Security-Policy.
	handle_path /onlyoffice/* {
		reverse_proxy onlyoffice:80 {
			header_up X-Forwarded-Host {http.request.hostport}/onlyoffice
		}
	}

	# File downloads (and MCP payloads) must pass through untouched so Range
	# and Content-Length survive: compression is scoped to the web handle
	# below, never applied here. WOPI callbacks never traverse this proxy:
	# the office server reaches the API directly at http://api:3001/wopi
	# over the compose network.
	handle /api/* {
		reverse_proxy api:3001
	}

	handle /mcp* {
		reverse_proxy api:3001
	}

	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}
