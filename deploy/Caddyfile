# Direct LAN HTTP works by default. Behind an HTTPS edge, set
# FDRIVE_PROXY_SCHEME=https so generated URLs and automatic cookies use HTTPS.
# The scheme is deployment-controlled; client headers cannot override it.
:80 {
	# No request body limit: uploads can be large files.
	request_body {
		max_size 0
	}

	header {
		-Server
	}

	# Bundled ONLYOFFICE stays on fdrive's own origin, so onboarding can
	# enable it without rebuilding the web app's Content-Security-Policy.
	handle_path /onlyoffice/* {
		reverse_proxy onlyoffice:80 {
			header_up X-Forwarded-Host {http.request.hostport}/onlyoffice
			header_up X-Forwarded-Proto {$FDRIVE_PROXY_SCHEME:http}
		}
	}

	# File downloads (and MCP payloads) must pass through untouched so Range
	# and Content-Length survive: compression is scoped to the web handle
	# below, never applied here. WOPI callbacks never traverse this proxy:
	# the office server reaches the API directly at http://api:3001/wopi
	# over the compose network.
	handle /api/* {
		reverse_proxy api:3001 {
			header_up X-Forwarded-Proto {$FDRIVE_PROXY_SCHEME:http}
		}
	}

	handle /mcp* {
		reverse_proxy api:3001 {
			header_up X-Forwarded-Proto {$FDRIVE_PROXY_SCHEME:http}
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy web:3000 {
			header_up X-Forwarded-Proto {$FDRIVE_PROXY_SCHEME:http}
		}
	}
}
