# Direct LAN HTTP works by default. Behind an HTTPS edge, set
# FDRIVE_PUBLIC_URL=https://... in deploy/.env: compose.yaml derives
# FDRIVE_FORWARDED_PROTO from it before starting Caddy, and that is what every
# upstream receives as X-Forwarded-Proto. The scheme is deployment-controlled;
# the header a client or an edge proxy sends is replaced, never trusted (any
# LAN client could otherwise claim https). ONLYOFFICE builds the URLs it hands
# the browser from this header, so a wrong value behind HTTPS surfaces only as
# a mixed-content "Download failed" in the editor.
:80 {
	# No request body limit: uploads can be large files.
	request_body {
		max_size 0
	}

	header {
		-Server
	}

	# Bundled ONLYOFFICE stays on fdrive's own origin, so onboarding can
	# enable it without rebuilding the web app's Content-Security-Policy.
	handle_path /onlyoffice/* {
		reverse_proxy onlyoffice:80 {
			header_up X-Forwarded-Host {http.request.hostport}/onlyoffice
			header_up X-Forwarded-Proto {$FDRIVE_FORWARDED_PROTO:http}
		}
	}

	# File downloads (and MCP payloads) must pass through untouched so Range
	# and Content-Length survive: compression is scoped to the web handle
	# below, never applied here. WOPI callbacks never traverse this proxy:
	# the office server reaches the API directly at http://api:3001/wopi
	# over the compose network.
	handle /api/* {
		reverse_proxy api:3001 {
			header_up X-Forwarded-Proto {$FDRIVE_FORWARDED_PROTO:http}
		}
	}

	handle /mcp* {
		reverse_proxy api:3001 {
			header_up X-Forwarded-Proto {$FDRIVE_FORWARDED_PROTO:http}
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy web:3000 {
			header_up X-Forwarded-Proto {$FDRIVE_FORWARDED_PROTO:http}
		}
	}
}
