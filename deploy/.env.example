# Copy this file to .env and fill in real values before running
# `docker compose up`. See README.md for what each file in this directory
# does and which of these variables it needs.

# --- compose.yaml (core stack) ---

# Host port the proxy listens on.
FDRIVE_HTTP_PORT=8090

# Where persistent data (Postgres, and optionally SFTPGo/ONLYOFFICE data)
# lives on the host.
FDRIVE_DATA_DIR=./data

# Password for the fdrive Postgres role and database.
POSTGRES_PASSWORD=change-me-postgres-password

# Base URL of your SFTPGo instance's REST API. If you run SFTPGo via
# compose.sftpgo.yaml on this same Docker network, use
# http://sftpgo:8080. Otherwise point this at your existing instance.
SFTPGO_URL=http://sftpgo:8080

# 32-byte (or longer) random key used to encrypt SFTPGo credentials at rest.
# Generate one with: openssl rand -base64 32
FDRIVE_MASTER_KEY=change-me-master-key

# Template used to derive each identity's SFTPGo home directory, for example
# /data/%u for a home per SFTPGo username.
FDRIVE_HOME_TEMPLATE=/data/%u

# --- compose.sftpgo.yaml (opt-in, only if you have no SFTPGo yet) ---

SFTPGO_ADMIN_USERNAME=admin
SFTPGO_ADMIN_PASSWORD=change-me-sftpgo-admin-password

# --- compose.office.yaml (opt-in, ONLYOFFICE WOPI editing) ---

# Secret used to sign requests between fdrive and Document Server. Generate
# one with: openssl rand -base64 32
ONLYOFFICE_JWT_SECRET=change-me-onlyoffice-jwt-secret
