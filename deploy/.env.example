# Copy this file to .env and fill in real values before running
# `docker compose up`. See README.md for what each file in this directory
# does and which of these variables it needs.

# --- compose.yaml (core stack) ---

# Host port the proxy listens on.
FDRIVE_HTTP_PORT=8090

# Where persistent Postgres and optional SFTPGo data lives on the host.
# Office proof keys use dedicated Docker named volumes instead.
FDRIVE_DATA_DIR=./data

# Password for the fdrive Postgres role and database.
POSTGRES_PASSWORD=change-me-postgres-password

# Base URL of your SFTPGo instance's REST API. If you run SFTPGo via
# compose.sftpgo.yaml on this same Docker network, use
# http://sftpgo:8080. Otherwise point this at your existing instance.
SFTPGO_URL=http://sftpgo:8080

# 32-byte (or longer) random key used to encrypt SFTPGo credentials at rest.
# Generate one with: openssl rand -base64 32
FDRIVE_MASTER_KEY=change-me-master-key

# Template used to derive each identity's SFTPGo home directory, for example
# /data/%u for a home per SFTPGo username.
FDRIVE_HOME_TEMPLATE=/data/%u

# Number of days a session stays valid before requiring re-login.
FDRIVE_SESSION_TTL_DAYS=30

# Whether the session cookie requires HTTPS: auto, true, or false. auto
# means secure when the app is deployed behind TLS, insecure otherwise.
FDRIVE_COOKIE_SECURE=auto

# Public base URL of this deployment, if different from what the proxy
# reports to the api container (custom domain, external TLS termination).
FDRIVE_PUBLIC_URL=

# --- compose.sftpgo.yaml (opt-in, only if you have no SFTPGo yet) ---

SFTPGO_ADMIN_USERNAME=admin
SFTPGO_ADMIN_PASSWORD=change-me-sftpgo-admin-password

# --- optional office overlays: choose ONLYOFFICE or Collabora ---
# See docs/OFFICE.md. Normal development and the core stack leave office off.
# Production requires FDRIVE_PUBLIC_URL above to be the public HTTPS app origin.

# ONLYOFFICE: compose.office.yaml with --profile office.
# Fixed Document Server JWT secret, separate from fdrive's signed WOPI tokens.
# Generate with: openssl rand -hex 32
# At least 32 letters, digits, underscores or hyphens; replace this placeholder.
ONLYOFFICE_JWT_SECRET=change-me-onlyoffice-jwt-secret

# Collabora: compose.office.collabora.yaml with --profile collabora.
# Route this additional public HTTPS hostname to the same edge proxy.
FDRIVE_COLLABORA_HOST=office.example.test

# API maximum document size in bytes. Office servers also apply their own limits.
FDRIVE_OFFICE_MAX_BYTES=104857600
# Default is view-only. Explicit provider/user/path grants required for editing.
# See docs/OFFICE.md. Grant only a subset of actual SFTPGo write permissions.
FDRIVE_OFFICE_EDIT_RULES=[]

# Host-run API settings, blank when office is disabled. The production overlays
# set these themselves; tools/office/setup.ts generates development equivalents.
# Product: onlyoffice or collabora.
FDRIVE_OFFICE_PRODUCT=
# Trusted internal discovery origin, e.g. http://onlyoffice or http://collabora:9980.
FDRIVE_OFFICE_URL=
# Browser URL, e.g. https://drive.example.test/onlyoffice or https://office.example.test.
FDRIVE_OFFICE_PUBLIC_URL=
# Canonical callback base: production http://api:3001/wopi;
# host-run development http://host.docker.internal:3001/wopi.
FDRIVE_WOPI_URL=

# --- index profile (compose.yaml --profile index): indexer, tika, embed ---

# Host directory that SFTPGo also serves, bind-mounted read-only into the
# indexer container at /roots/sftpgo. Must be the same directory SFTPGo uses
# for the "sftpgo" root so indexed paths line up with what users browse.
FDRIVE_INDEX_SFTPGO_DIR=/srv/sftpgo/data

# SFTPGo recycle-folder trash (optional). Requires the Event Manager rule described in
# docs/DEVELOPMENT.md under "Trash"; unset means deletes stay permanent.
# FDRIVE_SFTPGO_TRASH_PATH=/.trash
# Informational only: fdrive displays this retention but never enforces it.
# FDRIVE_SFTPGO_TRASH_RETENTION_HOURS=168

# Reverse-proxy hops in front of fdrive (the bundled Caddy counts as 1). Raise only when you add another proxy before it.
FDRIVE_TRUSTED_PROXY_HOPS=1
# Host interface for the bundled proxy port. Use 0.0.0.0 only when the TLS edge runs on another host.
FDRIVE_HTTP_BIND=127.0.0.1
# Opt-in SFTPGo overlay: admin API port, always loopback-only.
SFTPGO_ADMIN_PORT=8091

# Request body limits (optional, defaults shown): JSON bodies on authenticated routes, and public share uploads.
FDRIVE_JSON_MAX_BYTES=1048576
FDRIVE_SHARE_UPLOAD_MAX_BYTES=10737418240
