# fdrive deploy environment.
#
# Generated by tools/deploy/generate-env-example.ts (`pnpm env:example`); do not hand-edit.
# Copy to .env, then fill in every uncommented change-me value:
#   cp .env.example .env && chmod 600 .env
# Uncomment and edit any commented #KEY=value line to enable or override that subsystem.
# An empty or commented-out value is treated the same as the variable being unset.

# ---- Core ----

# LOG_LEVEL
# Minimum pino log level: fatal, error, warn, info, debug, trace, or silent.
# default: info
# example: debug
#LOG_LEVEL=info

# NODE_ENV
# development, production, or test; affects pretty-printed logs and defaults.
# default: development
# example: production
#NODE_ENV=development

# SFTPGO_URL
# Base URL of the SFTPGo instance fdrive proxies. Unset means setup happens through /setup.
# example: http://sftpgo:8080
#SFTPGO_URL=

# FDRIVE_MASTER_KEY (secret)
# Base64-encoded 32-byte key that encrypts stored credentials. Generate with `openssl rand -base64 32`; losing it makes stored credentials unrecoverable.
FDRIVE_MASTER_KEY=change-me

# FDRIVE_HOME_TEMPLATE
# Maps an identity's username to its home path, e.g. sftpgo:/{username}.
# default: sftpgo:/{username}
#FDRIVE_HOME_TEMPLATE=sftpgo:/{username}

# FDRIVE_AUTO_MIGRATE
# Whether the API runs pending database migrations on startup.
# default: true
#FDRIVE_AUTO_MIGRATE=true

# FDRIVE_TMP_DIR
# Directory archive jobs spool temporary files into. Defaults to the OS temp directory.
# example: /tmp
#FDRIVE_TMP_DIR=

# FDRIVE_JOB_MAX_BYTES
# Cap on the bytes a single archive/extract job may read, in bytes.
# default: 10737418240
#FDRIVE_JOB_MAX_BYTES=10737418240

# FDRIVE_JSON_MAX_BYTES
# Cap on a JSON request body's bytes (mkdir, move, copy, rename, delete, zip).
# default: 1048576
#FDRIVE_JSON_MAX_BYTES=1048576

# FDRIVE_ARCHIVE_PEEK_MAX_BYTES
# Cap on the compressed bytes read while streaming a tar-family archive's entry list.
# default: 536870912
#FDRIVE_ARCHIVE_PEEK_MAX_BYTES=536870912

# FDRIVE_ADMIN_USERS
# Comma-separated SFTPGo usernames always treated as admins, in addition to account records.
# example: alice,bob
#FDRIVE_ADMIN_USERS=

# FDRIVE_MCP_WRITES
# Enables the MCP write tools (create_folder, move_path). Off by default.
# default: false
#FDRIVE_MCP_WRITES=false

# POSTGRES_PASSWORD (secret)
# Password for the bundled Postgres database's fdrive user.
POSTGRES_PASSWORD=change-me

# FDRIVE_DATA_DIR
# Host directory holding Postgres data, OCR state, and the embedding model cache.
# default: ./data
#FDRIVE_DATA_DIR=./data

# FDRIVE_COMPOSE_FILES
# Extra compose files update.sh should pass with -f, space separated (for example compose.sftpgo-network.yaml compose.office.yaml).
# example: compose.sftpgo-network.yaml compose.office.yaml
#FDRIVE_COMPOSE_FILES=

# FDRIVE_PROFILES
# Compose profiles update.sh should pass with --profile, space separated (for example index office).
# example: index office
#FDRIVE_PROFILES=

# SFTPGO_ADMIN_USERNAME
# Admin username the bundled SFTPGo (compose.sftpgo.yaml) creates on first boot. Ignored unless that overlay is in use.
# default: admin
#SFTPGO_ADMIN_USERNAME=admin

# SFTPGO_ADMIN_PASSWORD
# Admin password for the bundled SFTPGo (compose.sftpgo.yaml). Treat as a secret. Required when that overlay is in use, ignored otherwise.
# example: a-strong-password
#SFTPGO_ADMIN_PASSWORD=

# ---- Network and sessions ----

# HOST
# Address the API binds to inside its container or host process.
# default: 0.0.0.0
#HOST=0.0.0.0

# FDRIVE_SESSION_TTL_DAYS
# How many days a signed-in session stays valid.
# default: 30
#FDRIVE_SESSION_TTL_DAYS=30

# FDRIVE_COOKIE_SECURE
# auto, true, or false; whether the session cookie requires HTTPS. Leave auto behind a TLS-terminating edge proxy.
# default: auto
#FDRIVE_COOKIE_SECURE=auto

# FDRIVE_TRUSTED_PROXY_HOPS
# How many reverse proxies in front of fdrive append an honest X-Forwarded-For entry. Edge proxies that run as containers cannot reach 127.0.0.1 on the host; set FDRIVE_HTTP_BIND accordingly and keep this count matching your proxy chain.
# default: 1
#FDRIVE_TRUSTED_PROXY_HOPS=1

# FDRIVE_PUBLIC_URL
# The externally reachable URL fdrive is served at, used in logged links and Office callbacks.
# example: https://fdrive.example.com
#FDRIVE_PUBLIC_URL=

# FDRIVE_HTTP_BIND
# Host address the proxy's published port binds to. Edge proxies that run as containers (Nginx Proxy Manager, Traefik, a dockerised Caddy) cannot reach 127.0.0.1 on the host; set 0.0.0.0 or the host's LAN address for them.
# default: 127.0.0.1
# example: 0.0.0.0
#FDRIVE_HTTP_BIND=127.0.0.1

# FDRIVE_HTTP_PORT
# Host port the proxy publishes.
# default: 8090
#FDRIVE_HTTP_PORT=8090

# SFTPGO_ADMIN_PORT
# Loopback host port the bundled SFTPGo's admin UI and API are published on (compose.sftpgo.yaml). Reach it through an SSH tunnel; never expose it.
# default: 8091
#SFTPGO_ADMIN_PORT=8091

# SFTPGO_ADMIN_BIND
# Host address the bundled SFTPGo's admin port binds to (compose.sftpgo.yaml). Default reaches it only from the server itself; set 0.0.0.0 to open it to your LAN, and keep it firewalled from the internet.
# default: 127.0.0.1
# example: 0.0.0.0
#SFTPGO_ADMIN_BIND=127.0.0.1

# ---- Indexer ----

# FDRIVE_INDEX_SFTPGO_DIR
# Host directory SFTPGo itself serves, bind-mounted read-only into the indexer and read-write into OCR. Required to use the index profile.
# example: /srv/sftpgo/data
#FDRIVE_INDEX_SFTPGO_DIR=

# FDRIVE_INDEX_SFTPGO_PATH
# The path at which SFTPGo itself sees FDRIVE_INDEX_SFTPGO_DIR; feeds the api's FDRIVE_INDEX_ROOTS default sftpgoPath.
# default: /srv/sftpgo/data
#FDRIVE_INDEX_SFTPGO_PATH=/srv/sftpgo/data

# FDRIVE_INDEX_UID
# Host uid/gid the indexer and OCR containers run as, matching SFTPGo's so 700 folders stay readable.
# default: 1000
#FDRIVE_INDEX_UID=1000

# ---- OCR ----

# TZ
# Time zone the OCR service schedules its nightly pass in.
# default: UTC
# example: Europe/Stockholm
#TZ=UTC

# OCR_EXCLUDE_GLOBS
# Comma-separated globs OCR never processes, matched against <root>/<relative path>.
# default: Programs/**,Photos/**,Videos/**
#OCR_EXCLUDE_GLOBS=Programs/**,Photos/**,Videos/**

# OCR_INCLUDE_GLOBS
# Comma-separated globs OCR is restricted to when set; overrides the default exclude set (OCR_EXCLUDE_GLOBS still applies on top). Lets a single-user instance restrict OCR to one home, for example fredrik/**, without changing the template.
# example: fredrik/**
#OCR_INCLUDE_GLOBS=

# ---- Office editing ----

# FDRIVE_OFFICE_PRODUCT
# onlyoffice or collabora. Required, alongside the other FDRIVE_OFFICE_* and FDRIVE_WOPI_URL variables, to enable Office editing.
# example: onlyoffice
#FDRIVE_OFFICE_PRODUCT=

# FDRIVE_OFFICE_URL
# Base URL of the Office/WOPI host server, reachable from the API over the compose network.
# example: http://onlyoffice
#FDRIVE_OFFICE_URL=

# FDRIVE_OFFICE_PUBLIC_URL
# The externally reachable URL of the Office server, used by the browser to load its editor.
# example: https://office.example.com
#FDRIVE_OFFICE_PUBLIC_URL=

# FDRIVE_WOPI_URL
# The API's own WOPI base URL the Office server calls back to; must end in /wopi.
# example: http://api:3001/wopi
#FDRIVE_WOPI_URL=

# FDRIVE_OFFICE_MAX_BYTES
# Cap on a document's bytes fdrive will open for editing.
# default: 104857600
#FDRIVE_OFFICE_MAX_BYTES=104857600

# FDRIVE_OFFICE_EDIT_RULES
# JSON array of bounded per-identity Office edit permission overrides. Empty/unset means the built-in default policy applies.
# example: []
#FDRIVE_OFFICE_EDIT_RULES=

# ONLYOFFICE_JWT_SECRET
# Shared secret between the api and ONLYOFFICE (compose.office.yaml): at least 32 letters, digits, underscores or hyphens, e.g. from `openssl rand -hex 32`. Treat as a secret. Required with that overlay, ignored otherwise.
# example: output-of-openssl-rand-hex-32
#ONLYOFFICE_JWT_SECRET=

# FDRIVE_COLLABORA_HOST
# Public hostname for Collabora (compose.office.collabora.yaml), routed to the same proxy port as fdrive. Required with that overlay, ignored otherwise.
# example: office.example.com
#FDRIVE_COLLABORA_HOST=

# ---- Trash ----

# FDRIVE_SFTPGO_TRASH_PATH
# The SFTPGo recycle-folder virtual path (see docs/DEVELOPMENT.md's Event Manager rule). Unset means deletes are permanent.
# example: /.trash
#FDRIVE_SFTPGO_TRASH_PATH=

# FDRIVE_SFTPGO_TRASH_RETENTION_HOURS
# Informational retention window shown in the Trash UI. fdrive never enforces it itself.
# example: 720
#FDRIVE_SFTPGO_TRASH_RETENTION_HOURS=

# ---- Shares ----

# FDRIVE_SHARE_UPLOAD_MAX_BYTES
# Cap on a public share upload's bytes.
# default: 10737418240
#FDRIVE_SHARE_UPLOAD_MAX_BYTES=10737418240
