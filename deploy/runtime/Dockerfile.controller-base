# Copies a small stdlib-only Python runtime into third-party worker images. The
# controller never talks to Docker; it only starts/stops a child in its own
# process namespace after the fdrive API authorizes that feature.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS controller
WORKDIR /runtime
COPY services/runtime/pyproject.toml ./
COPY services/runtime/src ./src
RUN pip install --no-cache-dir .
