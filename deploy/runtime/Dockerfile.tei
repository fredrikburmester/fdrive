FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254 AS controller

FROM ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.2@sha256:16230cd8f679ae5f8a51d585033628b1c0d45cd70c2bc9b0d208170d71218fdb
# Both the controller and TEI base use Debian Bookworm, so the Python runtime
# has a compatible libc. Do not copy from the newer generic python:slim image.
COPY --from=controller /usr/local /usr/local
COPY services/runtime/src/fdrive_runtime /usr/local/lib/python3.12/site-packages/fdrive_runtime
ENTRYPOINT ["python3", "-m", "fdrive_runtime.controller"]
