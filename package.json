{
  "name": "fdrive",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:env": "tsx tools/dev/ensure-env.ts && docker compose -f deploy/compose.dev.yaml up -d --wait",
    "dev:env:down": "docker compose -f deploy/compose.dev.yaml down",
    "dev:env:reset": "docker compose -f deploy/compose.dev.yaml down -v && tsx tools/dev/ensure-env.ts && docker compose -f deploy/compose.dev.yaml up -d --wait",
    "dev:seed": "tsx --conditions=development tools/dev/generate-seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@fdrive/testkit": "workspace:*",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^5.0.0",
    "turbo": "^2.10.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
