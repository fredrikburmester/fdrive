{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@fdrive/api",
        "exec",
        "tsx",
        "watch",
        "--conditions=development",
        "--env-file-if-exists=.env.dev",
        "--env-file-if-exists=../../.env.office.onlyoffice.dev",
        "src/main.ts"
      ],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@fdrive/web", "dev"],
      "port": 3002
    }
  ]
}
