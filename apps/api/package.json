{
  "name": "@fdrive/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./composition": {
      "types": "./src/composition.ts",
      "development": "./src/composition.ts",
      "default": "./dist/composition.js"
    },
    "./config": {
      "types": "./src/config.ts",
      "development": "./src/config.ts",
      "default": "./dist/config.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=.env.dev src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fdrive/contracts": "workspace:*",
    "@fdrive/core": "workspace:*",
    "@fdrive/db": "workspace:*",
    "@fdrive/sftpgo": "workspace:*",
    "@hono/node-server": "^1.19.5",
    "hono": "^4.9.10",
    "pino": "^10.0.0",
    "tar-stream": "^2.2.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@fdrive/config": "workspace:*",
    "@fdrive/testkit": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/tar-stream": "^2.2.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-orm": "^0.45.2",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
