{
  "name": "@fdrive/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=.env.dev src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fdrive/contracts": "workspace:*",
    "@fdrive/core": "workspace:*",
    "@fdrive/db": "workspace:*",
    "@fdrive/sftpgo": "workspace:*",
    "@hono/node-server": "^1.19.5",
    "hono": "^4.9.10",
    "pino": "^10.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@fdrive/config": "workspace:*",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^5.0.0",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
