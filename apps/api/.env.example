PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Required.
DATABASE_URL=postgres://user:password@localhost:5432/fdrive
SFTPGO_URL=http://localhost:8080
# 32-byte key, base64-encoded. Generate one with: openssl rand -base64 32
FDRIVE_MASTER_KEY=

FDRIVE_HOME_TEMPLATE=sftpgo:/{username}

# Optional, with defaults.
FDRIVE_SESSION_TTL_DAYS=30
# auto: secure cookies when NODE_ENV=production, insecure otherwise.
FDRIVE_COOKIE_SECURE=auto
# Public base URL of this deployment, if different from where the API itself
# thinks it is being served from (behind a proxy, custom domain, etc).
FDRIVE_PUBLIC_URL=
