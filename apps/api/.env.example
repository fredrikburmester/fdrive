# API host-process configuration. Generated by pnpm env:example; do not hand-edit.

# For the disposable development stack, prefer pnpm dev:env.

# Required: DATABASE_URL and FDRIVE_MASTER_KEY. All other keys are optional.

# Private persistent directory for encrypted backups and configuration uploads. Unset disables backups.
#FDRIVE_BACKUP_STATE_DIR=

# Start the isolated restore service. Normal API routes and all workers remain paused.
#FDRIVE_RESTORE_MODE=false

# Run the backup worker in this process; use one dedicated worker in production.
#FDRIVE_BACKUP_WORKER=false

# JSON list of persistent source mounts with kind (ocr, logs, office) and absolute path.
#FDRIVE_BACKUP_SOURCES=[]

# Optional controller base URL; unset probes the worker directly without controller revision checks.
#FDRIVE_EMBED_RUNTIME_URL=

# Optional controller base URL; unset probes the worker directly without controller revision checks.
#FDRIVE_IMAGE_EMBED_RUNTIME_URL=

# Optional controller base URL; unset probes the worker directly without controller revision checks.
#FDRIVE_TIKA_RUNTIME_URL=

# Tika base URL for direct readiness probes when no runtime controller is configured.
#FDRIVE_TIKA_URL=

# Shared internal credential for bundled worker configuration polling.
#FDRIVE_WORKER_TOKEN=

# TCP port the API listens on.
#PORT=3001

# Address the API binds to inside its container or host process.
#HOST=0.0.0.0

# Minimum pino log level: fatal, error, warn, info, debug, trace, or silent.
#LOG_LEVEL=info

# development, production, or test; affects pretty-printed logs and defaults.
#NODE_ENV=development

# Postgres connection string fdrive's own schema lives in.
DATABASE_URL=

# Base URL of the SFTPGo instance fdrive proxies; seeds and pins that storage provider at startup. Unset means setup happens through /setup.
#SFTPGO_URL=

# Base64-encoded 32-byte key that encrypts stored credentials. Generate with `openssl rand -base64 32`; losing it makes stored credentials unrecoverable.
FDRIVE_MASTER_KEY=

# Maps an identity's username to its home path, e.g. sftpgo:/{username}.
#FDRIVE_HOME_TEMPLATE=sftpgo:/{username}

# How many days a signed-in session stays valid.
#FDRIVE_SESSION_TTL_DAYS=30

# Hard cap in days on a session's age since login; activity never extends a session past it.
#FDRIVE_SESSION_MAX_AGE_DAYS=90

# auto, true, or false; whether the session cookie requires HTTPS. Leave auto behind a TLS-terminating edge proxy.
#FDRIVE_COOKIE_SECURE=auto

# How many reverse proxies in front of fdrive append an honest X-Forwarded-For entry. Edge proxies that run as containers cannot reach 127.0.0.1 on the host; set FDRIVE_HTTP_BIND accordingly and keep this count matching your proxy chain.
#FDRIVE_TRUSTED_PROXY_HOPS=1

# Whether the API runs pending database migrations on startup.
#FDRIVE_AUTO_MIGRATE=true

# Directory archive jobs spool temporary files into. Defaults to the OS temp directory.
#FDRIVE_TMP_DIR=

# Persistent private directory for Mac upload recovery. Unset disables writes.
#FDRIVE_DESKTOP_STATE_DIR=

# Cap on the bytes a single archive/extract job may read, in bytes.
#FDRIVE_JOB_MAX_BYTES=10737418240

# Cap on a JSON request body's bytes (mkdir, move, copy, rename, delete, zip).
#FDRIVE_JSON_MAX_BYTES=1048576

# Cap on the compressed bytes read while streaming a tar-family archive's entry list.
#FDRIVE_ARCHIVE_PEEK_MAX_BYTES=536870912

# Cap on a public share upload's bytes.
#FDRIVE_SHARE_UPLOAD_MAX_BYTES=10737418240

# Comma-separated SFTPGo usernames always treated as admins, in addition to account records.
#FDRIVE_ADMIN_USERS=

# Overrides the randomly generated one-time setup token. Mainly for tests and scripted installs.
#FDRIVE_SETUP_TOKEN=

# Enables create_folder and move_path for legacy MCP tokens only. New tokens use their individual access permissions.
#FDRIVE_MCP_WRITES=false

# JSON array of { name, sftpgoPath, indexerPath } mapping every indexed root. Unset disables search, thumbnails, and the Indexer page's per-root data.
#FDRIVE_INDEX_ROOTS=

# Base URL of the indexer's internal HTTP API. Unset disables the System > Indexer page and MCP document extraction. Explicit tokens can still read UTF-8 files directly.
#FDRIVE_INDEXER_URL=

# Base URL of the TEI embeddings service. Unset disables semantic search.
#FDRIVE_EMBED_URL=

# Base URL of the SigLIP image-embedding sidecar. Unset disables image search.
#FDRIVE_IMAGE_EMBED_URL=

# Directory the indexer writes thumbnails into, read by the API. Unset disables thumbnails.
#FDRIVE_THUMBS_DIR=

# Base URL of the OCR service's internal HTTP API. Unset disables the System > OCR page.
#FDRIVE_OCR_URL=

# Advanced Office provider override. Activation and the browser origin are controlled in fdrive settings.
#FDRIVE_OFFICE_PRODUCT=onlyoffice

# Advanced internal Office server override, reachable from the API over the compose network.
#FDRIVE_OFFICE_URL=http://onlyoffice

# Advanced external Office server override. Bundled ONLYOFFICE uses the saved fdrive origin plus /onlyoffice.
#FDRIVE_OFFICE_PUBLIC_URL=

# Advanced API WOPI callback override; must end in /wopi.
#FDRIVE_WOPI_URL=http://api:3001/wopi

# Cap on a document's bytes fdrive will open for editing.
#FDRIVE_OFFICE_MAX_BYTES=104857600

# Advanced per-identity path restrictions, applied in addition to the saved editor username list. Empty/unset adds no further restriction.
#FDRIVE_OFFICE_EDIT_RULES=
