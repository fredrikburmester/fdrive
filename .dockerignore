**/node_modules
**/.next
**/dist
**/coverage
**/.turbo
**/playwright-report
**/test-results
**/*.log
.git
.DS_Store

# Secrets: never let a real .env reach a build context or image layer.
# .env.example files are placeholders and stay included.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Worktrees, local dev data, the pnpm store, and perf output never belong in
# a build context either.
.worktrees
.fdrive-workflow
deploy/dev/.data
.pnpm-store
tools/perf/results
