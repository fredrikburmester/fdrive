{
  "name": "@fdrive/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing/memory-storage.ts",
      "development": "./src/testing/memory-storage.ts",
      "default": "./dist/testing/memory-storage.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.package.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@fdrive/config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
