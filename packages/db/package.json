{
  "name": "@fdrive/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema/app": "./src/schema/app.ts",
    "./schema/idx": "./src/schema/idx.ts"
  },
  "bin": {
    "fdrive-migrate": "./dist/bin/migrate.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@fdrive/config": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
