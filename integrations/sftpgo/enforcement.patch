--- a/internal/httpd/api_http_user.go
+++ b/internal/httpd/api_http_user.go
@@ -33,0 +34 @@ import (
+	"github.com/drakkan/sftpgo/v2/internal/fdrivelease"
@@ -49,0 +51,7 @@ func getUserConnection(w http.ResponseWriter, r *http.Request) (*Connection, err
+	if token := r.Header.Get(fdrivelease.Header); token != "" {
+		if !fdriveLeaseUser(&user) || !fdrivelease.Global.Validate(token, user.Username) {
+			sendAPIResponse(w, r, nil, "Storage lease is invalid or expired", http.StatusConflict)
+			return nil, fdrivelease.ErrLocked
+		}
+		user.FdriveWriteLease = token
+	}
